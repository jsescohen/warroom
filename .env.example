# Copy to .env and edit. Only the server reads this file; keys never reach the browser.

# Which AI provider to use: ollama | gemini | groq | openrouter | anthropic
LLM_PROVIDER=ollama
# Optional: overrides the provider-specific model below
LLM_MODEL=

# --- Ollama (local, free) ---  install from ollama.com, then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window. 4096 is plenty for the game and keeps VRAM use low (Ollama's default can be 16k+).
OLLAMA_NUM_CTX=4096

# --- Google Gemini ---  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq ---  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter ---  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Anthropic ---  https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Rate limiting (sensible per-provider defaults are used when blank) ---
# Minimum milliseconds between two requests to the provider
LLM_MIN_INTERVAL_MS=
# Simultaneous requests
LLM_MAX_CONCURRENT=1
# One request per AI nation per this many milliseconds
LLM_ACTOR_COOLDOWN_MS=45000
# AI-nation requests are skipped when this many are already waiting
LLM_MAX_QUEUED_AI=4
LLM_TIMEOUT_MS=

API_PORT=8787

# --- Closed beta ---
# Comma-separated tester codes. When set, players must enter one before the game loads, and the
# AI and map files are refused without it. Leave empty to disable the gate (local development).
BETA_CODES=
# Optional: signs the unlock cookie (any long random string). Changing it logs every tester out.
BETA_SECRET=

# --- Accounts (replaces BETA_CODES when set) ---
# Players sign in with Google / Discord through a free Supabase project; the admin approves them.
# Supabase dashboard → Project Settings → API: the project URL and the "anon" public key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase → Connect → Session pooler connection string (accounts + cloud saves). Keep it secret.
DATABASE_URL=
# Admin accounts (comma-separated emails): always let in, can approve others and open the admin panel.
ADMIN_EMAILS=
# Sign-in buttons to show; each must be enabled under Supabase → Authentication → Providers.
AUTH_PROVIDERS=google,discord
# Local development only: sign in by typing any email, without Supabase (ignored in production).
AUTH_DEV=false
